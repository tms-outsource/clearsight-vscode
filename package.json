{
  "name": "clearsight-theme",
  "displayName": "Clearsight",
  "description": "A calm, readable theme. Every syntax color, comments included, passes WCAG AA contrast and stays distinguishable for colorblind developers.",
  "version": "0.1.0",
  "publisher": "tms-outsource",
  "license": "MIT",
  "icon": "images/icon.png",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "accessible",
    "accessibility",
    "colorblind",
    "color blind",
    "wcag",
    "contrast",
    "low contrast",
    "soft",
    "readable",
    "eye strain"
  ],
  "galleryBanner": {
    "color": "#151a20",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tms-outsource/clearsight-vscode"
  },
  "bugs": {
    "url": "https://github.com/tms-outsource/clearsight-vscode/issues"
  },
  "homepage": "https://tms-outsource.com/t/clearsight/",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-contrast.mjs && node scripts/check-theme.mjs",
    "check:palette": "node scripts/check-contrast.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "report": "node scripts/check-contrast.mjs --report",
    "tune": "node scripts/tune.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "npx --yes @vscode/vsce@3 package",
    "screenshots": "node scripts/screenshots.mjs",
    "ports": "node scripts/ports.mjs"
  },
  "contributes": {
    "themes": [
      {
        "label": "Clearsight",
        "uiTheme": "vs-dark",
        "path": "./themes/clearsight-color-theme.json"
      },
      {
        "label": "Clearsight No Italics",
        "uiTheme": "vs-dark",
        "path": "./themes/clearsight-no-italics-color-theme.json"
      },
      {
        "label": "Clearsight Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/clearsight-soft-color-theme.json"
      },
      {
        "label": "Clearsight Soft No Italics",
        "uiTheme": "vs-dark",
        "path": "./themes/clearsight-soft-no-italics-color-theme.json"
      },
      {
        "label": "Clearsight Light",
        "uiTheme": "vs",
        "path": "./themes/clearsight-light-color-theme.json"
      },
      {
        "label": "Clearsight Light No Italics",
        "uiTheme": "vs",
        "path": "./themes/clearsight-light-no-italics-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "shiki": "^1.29.2"
  }
}
